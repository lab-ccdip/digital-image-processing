clc;
clear;
close all;
img = imread('flower.jpg'); 
figure;
subplot(2,2,1); 
imshow(img);
title('Original Color Image');
hsvImg = rgb2hsv(img); 
V = hsvImg(:,:,3); 
Veq = histeq(V); 
hsvImg(:,:,3) = Veq; 
equalizedImg = hsv2rgb(hsvImg); 
subplot(2,2,2); 
imshow(equalizedImg); 
title('Histogram Equalized Color Image'); 
subplot(2,2,3); 
imhist(V); 
title('Original Value Histogram'); 
subplot(2,2,4);
imhist(Veq);
title('Equalized Value Histogram'); 
